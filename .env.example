# Public production base URL
BRIDGE_BASE_URL=https://client-bridge.armsreachdigital.agency

# Protects bridge-issued OAuth clients/tokens. Use at least 32 random characters.
BRIDGE_SIGNING_SECRET=

# Password shown only on the bridge OAuth authorization screen.
BRIDGE_ADMIN_PASSWORD=

# Optional direct bearer key for testing/non-OAuth MCP clients.
BRIDGE_API_KEY=

# HighLevel agency Private Integration Token (PIT). Keep server-side only.
HIGHLEVEL_AGENCY_PIT=

# Marketplace OAuth client credentials. The bridge stores the installed agency
# authorization tokens encrypted in Vercel Blob and refreshes them automatically.
HIGHLEVEL_OAUTH_CLIENT_ID=
HIGHLEVEL_OAUTH_CLIENT_SECRET=
BLOB_READ_WRITE_TOKEN=

# HighLevel agency/company ID. Required for agency-to-location token exchange.
HIGHLEVEL_COMPANY_ID=

# Optional JSON object of locationId -> sub-account PIT.
# Use only as a fallback for locations where agency-to-location token exchange cannot be used.
# Example: {"LOCATION_ID":"pit-..."}
HIGHLEVEL_LOCATION_PITS={}
